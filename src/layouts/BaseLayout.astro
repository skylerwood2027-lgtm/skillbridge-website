---
import '@fontsource-variable/familjen-grotesk';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../styles/global.css';
import headFont from '@fontsource-variable/familjen-grotesk/files/familjen-grotesk-latin-wght-normal.woff2?url';
import accentFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-italic.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import siteConfig from '../config.json';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  /** Every page ends on the Brief band. Opt out only if a page supplies its own
      closing action (the /get pages do). */
  newsletter?: boolean;
  /** 'minimal' is the wordmark alone, for pages opened from a DM. */
  header?: 'full' | 'minimal';
  footer?: boolean;
  /** Keeps a page out of search results. */
  noindex?: boolean;
}
const {
  title,
  description = siteConfig.description,
  ogType = 'website',
  newsletter = true,
  header = 'full',
  footer = true,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.siteUrl).href;
const ogImage = new URL('/og.png', Astro.site ?? siteConfig.siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        // Motion only when the visitor hasn't asked for less. Nothing is ever
        // hidden while waiting for a script: the load-in is plain CSS.
        if (window.matchMedia && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          r.classList.add('motion');
        }
      })();
    </script>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" as="font" type="font/woff2" href={headFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={accentFont} crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#F7F5F0" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader minimal={header === 'minimal'} />
    <main id="main"><slot /></main>
    {newsletter && <NewsletterBand />}
    {footer && <SiteFooter />}
    <script is:inline>
      // Scroll-reveal for the pages that still mark elements with .reveal.
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  main {
    flex: 1 0 auto;
    width: 100%;
  }
</style>
