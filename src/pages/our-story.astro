---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import siteConfig from '../config.json';
import story from '../data/ourStory.json';
---

<BaseLayout title="Our Story · SkillBridge">
  <article class="story">
    <header class="story__hero">
      <div class="container container-narrow">
        <h1 class="story__headline reveal" data-delay="1">{story.headline}</h1>
      </div>
    </header>

    <div class="container container-narrow story__body">
      {
        story.intro.map((p: string, i: number) => (
          <p class="story__intro reveal" data-delay={String(i + 1)}>
            {p}
          </p>
        ))
      }

      {
        story.sections.map((s: any) => (
          <section class="story__section reveal">
            <h2 class="story__heading">{s.heading}</h2>
            {s.paragraphs.map((p: string) => (
              <p>{p}</p>
            ))}
          </section>
        ))
      }

      <div class="story__cta reveal">
        <Button href={siteConfig.discordUrl} variant="discord" size="lg" external>Join the Discord</Button>
        <Button href="/resources" variant="outline">Get the free toolkit</Button>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .story__hero {
    background: radial-gradient(120% 90% at 82% -10%, var(--light) 0%, #fff 58%);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 2rem + 4vw, 4.5rem) clamp(2rem, 1.5rem + 3vw, 3rem);
  }
  .story__headline {
    margin-top: 0.4rem;
    font-size: clamp(2.1rem, 1.5rem + 2.4vw, 3.2rem);
    max-width: 20ch;
  }

  .story__body { padding-block: clamp(2rem, 1.5rem + 3vw, 3.5rem); }

  /* readable measure: shorter lines + more air so the column reads light, not dense */
  /* opening intro paragraphs — set a touch larger than body for editorial lead-in */
  .story__intro {
    font-size: 1.18rem;
    line-height: 1.72;
    color: var(--ink);
    max-width: 58ch;
    margin-bottom: 1.35rem;
  }
  .story__intro:last-of-type { margin-bottom: 2.75rem; }

  .story__section { margin-bottom: 2.75rem; }
  .story__heading {
    font-size: var(--step-2);
    margin-bottom: 0.8rem;
  }
  .story__section p {
    line-height: 1.75;
    margin-bottom: 1.2rem;
    max-width: 60ch;
  }
  .story__section p:last-child { margin-bottom: 0; }

  .story__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.4rem;
  }
</style>
