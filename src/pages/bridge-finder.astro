---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config.json';

// Bridge Finder: a student drops in the Connections.csv LinkedIn exports, names the
// places they want to work, and sees who they already know there ("bridges") and
// who to ask for a coffee chat first. Everything runs in the browser tab. The site
// is static and has no backend, and a student's contact list should never need one.
const questionsGuide = '/resources/three-better-networking-questions.pdf';
---

<BaseLayout
  title="Bridge Finder · SkillBridge"
  description="Drop in your LinkedIn connections and see who you already know at the companies you want — and who to ask for a coffee chat first. Runs in your browser; nothing is uploaded."
>
  <div class="bf">
    <section class="bf-hero">
      <div class="container bf-hero__grid">
        <div class="bf-hero__main">
          <p class="bf-kicker">Bridge Finder</p>
          <h1 class="bf-title">See who you know at the places you want to work.</h1>
          <p class="bf-lead">
            Upload your LinkedIn connections. We'll show who you know at each company and who to message first.
          </p>

          <label class="bf-drop" data-drop>
            <input class="visually-hidden" type="file" accept=".csv,text/csv" data-file />
            <svg class="bf-drop__icon" viewBox="0 0 48 20" aria-hidden="true">
              <path d="M2 18 Q12 2 24 2 Q36 2 46 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
              <path d="M2 18 H46 M12 18 V9 M24 18 V3 M36 18 V9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span class="bf-drop__title">Drop <b>Connections.csv</b> here</span>
            <span class="bf-drop__sub">or <u>choose the file</u></span>
          </label>
          <p class="bf-error" role="alert" data-error hidden></p>

          <div class="bf-hero__row">
            <button type="button" class="bf-link-btn" data-sample>Try it with sample data</button>
            <p class="bf-privacy">Your file never leaves your browser.</p>
          </div>
        </div>

        <aside class="bf-steps" aria-labelledby="bf-steps-title">
          <h2 id="bf-steps-title" class="bf-steps__title">How to get the file</h2>
          <ol class="bf-steps__list">
            <li>On LinkedIn, go to <b>Me</b> &gt; <b>Settings &amp; Privacy</b>.</li>
            <li>Click <b>Data privacy</b> &gt; <b>Download your data</b>.</li>
            <li>Pick <b>Connections</b>, then click <b>Request archive</b>.</li>
            <li>Open LinkedIn's email, unzip the download, and drop <b>Connections.csv</b> here.</li>
          </ol>
          <p class="bf-steps__note">
            Seeing <b>Request pending</b>? You already asked. Watch your email.
          </p>
        </aside>
      </div>
    </section>

    <section class="bf-results container" data-results hidden aria-live="polite">
      <div class="bf-sample-bar" data-sample-bar hidden>
        Showing sample data with made-up people.
        <button type="button" class="bf-link-btn" data-clear>Use my own file instead</button>
      </div>

      <div class="bf-setup">
        <div>
          <h2 class="bf-h2">Where do you want to go?</h2>
          <p class="bf-summary" data-summary></p>
        </div>
        <form class="bf-targets" data-target-form>
          <label for="bf-target-input" class="bf-label">Add a company or school</label>
          <div class="bf-targets__field">
            <input id="bf-target-input" class="bf-input" type="text" autocomplete="off" placeholder="e.g. Nike, Stanford" data-target-input />
            <button type="submit" class="bf-btn">Add</button>
          </div>
          <ul class="bf-chips" data-targets aria-label="Your target companies"></ul>
        </form>
        <div class="bf-suggest" data-suggest-wrap hidden>
          <p class="bf-label">Or tap one from your network</p>
          <ul class="bf-chips" data-suggest></ul>
        </div>
      </div>

      <div class="bf-layout">
        <div class="bf-companies">
          <a class="bf-jump" href="#bf-chat-title" data-jump hidden>Go to your messages</a>
          <div data-companies></div>
          <div class="bf-empty" data-empty hidden>
            <h3>Add a company to see who you know there.</h3>
          </div>
          <div class="bf-nobody" data-nobody-wrap hidden>
            <h3 class="bf-nobody__title">No one yet</h3>
            <p class="bf-nobody__body">Search LinkedIn for students and alumni there.</p>
            <ul class="bf-nobody__list" data-nobody></ul>
          </div>
        </div>

        <aside class="bf-chat" aria-labelledby="bf-chat-title">
          <h2 id="bf-chat-title" class="bf-chat__title">Your messages <span data-chat-count>(0)</span></h2>
          <p class="bf-chat__empty" data-chat-empty>Tap <b>Add to list</b> on anyone you'd like to talk to. Two or three is plenty.</p>

          <label class="bf-label bf-chat__me" for="bf-myname">Your first name</label>
          <input id="bf-myname" class="bf-input" type="text" autocomplete="given-name" placeholder="Your name" data-myname />

          <ul class="bf-chat__list" data-chat-list></ul>

          <details class="bf-chat__edit">
            <summary>Change the wording</summary>
            <textarea id="bf-template" class="bf-input bf-textarea" rows="8" aria-label="Message wording" data-template></textarea>
            <p class="bf-hint">{'{first}'} is their first name, {'{company}'} is their company, {'{me}'} is your name.</p>
            <button type="button" class="bf-link-btn bf-hint" data-reset-template>Reset to the original</button>
          </details>
          <p class="bf-hint">
            What to ask on the call: <a href={questionsGuide}>Three better networking questions</a>
          </p>
        </aside>
      </div>
    </section>

    <section class="bf-cta container">
      <p>Nervous about the call? Ask in the SkillBridge Discord.</p>
      <a class="bf-btn bf-btn--blue" href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Join the Discord</a>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var root = document.querySelector('.bf');
    if (!root) return;
    var $ = function (sel) { return root.querySelector(sel); };

    var els = {
      drop: $('[data-drop]'), file: $('[data-file]'), error: $('[data-error]'),
      sample: $('[data-sample]'), clear: $('[data-clear]'), sampleBar: $('[data-sample-bar]'),
      results: $('[data-results]'), summary: $('[data-summary]'),
      form: $('[data-target-form]'), input: $('[data-target-input]'), targets: $('[data-targets]'),
      suggestWrap: $('[data-suggest-wrap]'), suggest: $('[data-suggest]'),
      companies: $('[data-companies]'), empty: $('[data-empty]'),
      nobodyWrap: $('[data-nobody-wrap]'), nobody: $('[data-nobody]'),
      chatList: $('[data-chat-list]'), chatEmpty: $('[data-chat-empty]'), chatCount: $('[data-chat-count]'),
      myname: $('[data-myname]'), template: $('[data-template]'),
    };

    var DEFAULT_TEMPLATE =
      "Hi {first}, I'm a high school student exploring careers, and I saw you're at {company}. " +
      "Would you be open to a 15-minute call in the next few weeks? I'd love to hear how you got " +
      "started and what you wish you'd known at my age.\n\nThanks either way,\n{me}";

    var state = { people: [], targets: [], chat: [], isSample: false };

    // ---- per-viewer conveniences (never the contact list itself) -------------
    function load(key, fallback) {
      try { var v = localStorage.getItem(key); return v == null ? fallback : JSON.parse(v); } catch (e) { return fallback; }
    }
    function save(key, val) { try { localStorage.setItem(key, JSON.stringify(val)); } catch (e) {} }

    els.template.value = load('sb-bf-template', DEFAULT_TEMPLATE);
    els.myname.value = load('sb-bf-name', '');
    // Every keystroke in either box redraws the visible message, so what you see is
    // exactly what Copy puts on the clipboard.
    els.template.addEventListener('input', function () { save('sb-bf-template', els.template.value); updatePreviews(); });
    els.myname.addEventListener('input', function () { save('sb-bf-name', els.myname.value); updatePreviews(); });
    $('[data-reset-template]').addEventListener('click', function () {
      els.template.value = DEFAULT_TEMPLATE;
      save('sb-bf-template', DEFAULT_TEMPLATE);
      updatePreviews();
    });

    // ---- parsing ---------------------------------------------------------------
    function parseCSV(text) {
      var rows = [], row = [], field = '', q = false;
      for (var i = 0; i < text.length; i++) {
        var c = text[i];
        if (q) {
          if (c === '"') { if (text[i + 1] === '"') { field += '"'; i++; } else q = false; }
          else field += c;
        } else if (c === '"') q = true;
        else if (c === ',') { row.push(field); field = ''; }
        else if (c === '\n' || c === '\r') {
          if (c === '\r' && text[i + 1] === '\n') i++;
          row.push(field); rows.push(row); row = []; field = '';
        } else field += c;
      }
      if (field || row.length) { row.push(field); rows.push(row); }
      return rows;
    }

    var MONTHS = { jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5, jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11 };
    function parseDate(s) {
      var m = /(\d{1,2})\s+([A-Za-z]{3})[A-Za-z]*\s+(\d{4})/.exec(s || '');
      if (m && MONTHS[m[2].toLowerCase()] != null) return new Date(+m[3], MONTHS[m[2].toLowerCase()], +m[1]);
      var t = Date.parse(s);
      return isNaN(t) ? null : new Date(t);
    }

    // LinkedIn's file opens with a few "Notes:" lines before the real header row.
    function toPeople(text) {
      var rows = parseCSV(text.replace(/^﻿/, ''));
      var h = -1;
      for (var i = 0; i < Math.min(rows.length, 15); i++) {
        var joined = rows[i].join('|').toLowerCase();
        if (joined.indexOf('first name') > -1 && joined.indexOf('company') > -1) { h = i; break; }
      }
      if (h < 0) return null;
      var head = rows[h].map(function (x) { return x.trim().toLowerCase(); });
      var col = function (name) { return head.indexOf(name); };
      var cF = col('first name'), cL = col('last name'), cU = col('url'), cC = col('company'), cP = col('position'), cD = col('connected on');
      var out = [];
      for (var r = h + 1; r < rows.length; r++) {
        var x = rows[r];
        var first = (x[cF] || '').trim(), last = (x[cL] || '').trim();
        if (!first && !last) continue;
        out.push({
          id: 'p' + r,
          first: first, last: last,
          url: cU > -1 ? (x[cU] || '').trim() : '',
          company: cC > -1 ? (x[cC] || '').trim() : '',
          position: cP > -1 ? (x[cP] || '').trim() : '',
          connected: cD > -1 ? parseDate(x[cD]) : null,
        });
      }
      return out;
    }

    // ---- matching + ranking ----------------------------------------------------
    function norm(s) {
      return (' ' + (s || '').toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ') + ' ')
        .replace(/ (the|inc|llc|ltd|corp|corporation|co|company|plc|group) /g, ' ')
        .replace(/\s+/g, ' ');
    }
    function matches(target, company) {
      var t = norm(target), c = norm(company);
      return t.trim() && c.indexOf(t) > -1;
    }

    var YEAR = 365 * 864e5;
    function reasons(p) {
      var out = [], score = 0, pos = p.position.toLowerCase();
      if (/\b(intern|student|co-?op|apprentice|fellow)\b/.test(pos)) { out.push('Intern or student'); score += 3; }
      else if (/\b(recruit|talent|university relations|campus|early career)/.test(pos)) { out.push('Recruiter'); score += 2; }
      if (p.connected && Date.now() - p.connected.getTime() < YEAR) { out.push('Connected this year'); score += 2; }
      return { score: score, list: out };
    }
    function rankPeople(list) {
      return list.map(function (p) { var r = reasons(p); return { p: p, score: r.score, why: r.list }; })
        .sort(function (a, b) {
          return b.score - a.score || ((b.p.connected ? +b.p.connected : 0) - (a.p.connected ? +a.p.connected : 0));
        });
    }

    // ---- rendering helpers -----------------------------------------------------
    function el(tag, cls, text) {
      var n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    }
    function fullName(p) { return (p.first + ' ' + p.last).trim(); }
    function safeUrl(u) { return /^https:\/\/([a-z]+\.)?linkedin\.com\//i.test(u) ? u : ''; }

    // The signature mark: one bridge span per person you know there, up to five.
    // Zero draws a broken, dashed span.
    function spans(n) {
      var k = Math.min(n, 5), w = Math.max(k, 1) * 22 + 4;
      var ns = 'http://www.w3.org/2000/svg';
      var svg = document.createElementNS(ns, 'svg');
      svg.setAttribute('viewBox', '0 0 ' + w + ' 16');
      svg.setAttribute('width', w); svg.setAttribute('height', 16);
      svg.setAttribute('aria-hidden', 'true');
      svg.setAttribute('class', 'bf-spans' + (n ? '' : ' bf-spans--none'));
      var d = 'M2 14 H' + (w - 2);
      for (var i = 0; i < Math.max(k, 1); i++) { var x = 2 + i * 22; d += ' M' + x + ' 14 Q' + (x + 11) + ' 0 ' + (x + 22) + ' 14'; }
      var path = document.createElementNS(ns, 'path');
      path.setAttribute('d', d);
      svg.appendChild(path);
      return svg;
    }

    function chip(label, onClick, opts) {
      var li = el('li');
      var b = el('button', 'bf-chip' + (opts && opts.removable ? ' bf-chip--on' : ''), label);
      b.type = 'button';
      if (opts && opts.aria) b.setAttribute('aria-label', opts.aria);
      b.addEventListener('click', onClick);
      li.appendChild(b);
      return li;
    }

    // ---- render ------------------------------------------------------------------
    function render() {
      var people = state.people;
      // Count by normalized name so "Nike" and "Nike, Inc." are one employer, shown
      // under whichever spelling appears first in the file.
      var companyCount = {}, label = {};
      people.forEach(function (p) {
        if (!p.company) return;
        var k = norm(p.company).trim();
        if (!label[k]) label[k] = p.company;
        companyCount[label[k]] = (companyCount[label[k]] || 0) + 1;
      });
      var nCompanies = Object.keys(companyCount).length;
      els.summary.textContent = people.length + ' connection' + (people.length === 1 ? '' : 's') +
        ' across ' + nCompanies + ' compan' + (nCompanies === 1 ? 'y' : 'ies') + '.';

      // targets
      els.targets.replaceChildren();
      state.targets.forEach(function (t) {
        els.targets.appendChild(chip(t + ' ×', function () { removeTarget(t); }, { removable: true, aria: 'Remove ' + t }));
      });

      // suggestions: the biggest employers in their network that aren't targets yet
      var top = Object.keys(companyCount)
        .filter(function (c) { return !state.targets.some(function (t) { return matches(t, c); }); })
        .sort(function (a, b) { return companyCount[b] - companyCount[a]; })
        .slice(0, 8);
      els.suggest.replaceChildren();
      top.forEach(function (c) {
        els.suggest.appendChild(chip('+ ' + c + ' (' + companyCount[c] + ')', function () { addTarget(c); }, { aria: 'Add ' + c }));
      });
      els.suggestWrap.hidden = !top.length;

      // company groups
      els.companies.replaceChildren();
      els.nobody.replaceChildren();
      var nobody = [];
      state.targets.forEach(function (t) {
        var found = people.filter(function (p) { return matches(t, p.company); });
        if (!found.length) { nobody.push(t); return; }
        // Show the company the way the file spells it ("Stripe", not a typed "stripe").
        var exact = found.filter(function (p) { return norm(p.company) === norm(t); })[0];
        els.companies.appendChild(companyBlock(exact ? exact.company : t, rankPeople(found)));
      });
      nobody.forEach(function (t) {
        var li = el('li', 'bf-nobody__item');
        li.appendChild(spans(0));
        li.appendChild(el('span', 'bf-nobody__name', t));
        var a = el('a', 'bf-nobody__search', 'Search LinkedIn for people there');
        a.href = 'https://www.linkedin.com/search/results/people/?keywords=' + encodeURIComponent(t);
        a.target = '_blank'; a.rel = 'noopener noreferrer';
        li.appendChild(a);
        els.nobody.appendChild(li);
      });
      els.nobodyWrap.hidden = !nobody.length;
      els.empty.hidden = state.targets.length > 0;

      renderChat();
    }

    function companyBlock(target, ranked) {
      var art = el('article', 'bf-co');
      var head = el('header', 'bf-co__head');
      head.appendChild(spans(ranked.length));
      var h = el('h3', 'bf-co__title', ranked.length + (ranked.length === 1 ? ' bridge into ' : ' bridges into ') + target);
      head.appendChild(h);
      art.appendChild(head);

      var list = el('ol', 'bf-people');
      ranked.forEach(function (r, i) {
        var li = el('li', 'bf-person' + (i === 0 ? ' bf-person--first' : ''));
        if (i >= 3) li.hidden = true;
        var who = el('div', 'bf-person__who');
        var name = el('p', 'bf-person__name');
        var url = safeUrl(r.p.url);
        if (url) {
          var a = el('a', null, fullName(r.p)); a.href = url; a.target = '_blank'; a.rel = 'noopener noreferrer';
          name.appendChild(a);
        } else name.textContent = fullName(r.p);
        if (i === 0) name.appendChild(el('span', 'bf-badge', 'Ask first'));
        who.appendChild(name);
        who.appendChild(el('p', 'bf-person__role', [r.p.position, r.p.company].filter(Boolean).join(', ')));
        if (r.why.length) {
          var why = el('ul', 'bf-person__why', null);
          why.setAttribute('aria-label', 'Why this person');
          r.why.forEach(function (w) { why.appendChild(el('li', 'bf-tag', w)); });
          who.appendChild(why);
        }
        li.appendChild(who);
        var inChat = state.chat.some(function (c) { return c.p.id === r.p.id; });
        var add = el('button', 'bf-add' + (inChat ? ' is-added' : ''), inChat ? 'Added ✓' : 'Add to list');
        add.type = 'button';
        add.setAttribute('aria-pressed', inChat ? 'true' : 'false');
        add.addEventListener('click', function () { toggleChat(r.p, target); });
        li.appendChild(add);
        list.appendChild(li);
      });
      art.appendChild(list);

      if (ranked.length > 3) {
        var more = el('button', 'bf-link-btn bf-co__more', 'Show ' + (ranked.length - 3) + ' more');
        more.type = 'button';
        more.addEventListener('click', function () {
          list.querySelectorAll('li[hidden]').forEach(function (n) { n.hidden = false; });
          more.remove();
        });
        art.appendChild(more);
      }
      return art;
    }

    function fill(p, target) {
      var me = els.myname.value.trim() || '[your name]';
      return els.template.value
        .replace(/\{first\}/g, p.first || 'there')
        .replace(/\{company\}/g, p.company || target)
        .replace(/\{me\}/g, me);
    }

    var previews = [];
    function updatePreviews() {
      previews.forEach(function (v) { v.node.textContent = fill(v.c.p, v.c.target); });
    }

    function renderChat() {
      els.chatList.replaceChildren();
      previews = [];
      els.chatEmpty.hidden = state.chat.length > 0;
      els.chatCount.textContent = '(' + state.chat.length + ')';
      var jump = root.querySelector('[data-jump]');
      jump.hidden = !state.chat.length;
      jump.textContent = 'Go to your messages (' + state.chat.length + ')';
      // One message open at a time keeps the panel short; the newest add opens.
      if (!state.chat.some(function (c) { return c.p.id === state.open; })) {
        state.open = state.chat.length ? state.chat[state.chat.length - 1].p.id : null;
      }
      state.chat.forEach(function (c) {
        var isOpen = c.p.id === state.open;
        var li = el('li', 'bf-chat__item' + (isOpen ? ' is-open' : ''));
        var top = el('div', 'bf-chat__row');
        var info = el('button', 'bf-chat__toggle');
        info.type = 'button';
        info.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        info.appendChild(el('span', 'bf-chat__name', fullName(c.p)));
        info.appendChild(el('span', 'bf-chat__co', c.p.company || c.target));
        info.addEventListener('click', function () { state.open = isOpen ? '' : c.p.id; renderChat(); });
        top.appendChild(info);
        var rm = el('button', 'bf-x', '×');
        rm.type = 'button';
        rm.setAttribute('aria-label', 'Remove ' + fullName(c.p) + ' from your list');
        rm.addEventListener('click', function () { toggleChat(c.p, c.target); });
        top.appendChild(rm);
        li.appendChild(top);
        if (!isOpen) { els.chatList.appendChild(li); return; }

        var msg = el('p', 'bf-chat__msg', fill(c.p, c.target));
        previews.push({ node: msg, c: c });
        li.appendChild(msg);

        var actions = el('div', 'bf-chat__actions');
        var copy = el('button', 'bf-btn bf-btn--sm', 'Copy message');
        copy.type = 'button';
        copy.addEventListener('click', function () {
          var text = fill(c.p, c.target);
          var done = function () { copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = 'Copy message'; }, 1600); };
          if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function () { window.prompt('Copy this message:', text); });
          else window.prompt('Copy this message:', text);
        });
        actions.appendChild(copy);
        var url = safeUrl(c.p.url);
        if (url) {
          var open = el('a', 'bf-chat__open', 'Open profile');
          open.href = url; open.target = '_blank'; open.rel = 'noopener noreferrer';
          actions.appendChild(open);
        }
        li.appendChild(actions);
        els.chatList.appendChild(li);
      });
    }

    // ---- actions -------------------------------------------------------------------
    function addTarget(t) {
      t = t.trim();
      if (!t || state.targets.some(function (x) { return norm(x) === norm(t); })) return;
      state.targets.push(t);
      if (!state.isSample) save('sb-bf-targets', state.targets);
      render();
    }
    function removeTarget(t) {
      state.targets = state.targets.filter(function (x) { return x !== t; });
      if (!state.isSample) save('sb-bf-targets', state.targets);
      render();
    }
    function toggleChat(p, target) {
      var i = state.chat.findIndex(function (c) { return c.p.id === p.id; });
      if (i > -1) state.chat.splice(i, 1);
      else { state.chat.push({ p: p, target: target }); state.open = p.id; }
      render();
    }

    function showError(msg) { els.error.textContent = msg; els.error.hidden = !msg; }

    function start(people, isSample, targets) {
      state.people = people;
      state.isSample = isSample;
      state.chat = [];
      state.targets = targets;
      els.sampleBar.hidden = !isSample;
      els.results.hidden = false;
      showError('');
      render();
      els.results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function readFile(f) {
      if (!f) return;
      if (/\.zip$/i.test(f.name)) {
        showError("That's the zip LinkedIn emailed you. Open it first, then drop the Connections.csv file from inside.");
        return;
      }
      var reader = new FileReader();
      reader.onload = function () {
        var people = toPeople(String(reader.result || ''));
        if (!people) {
          showError("This file doesn't look like LinkedIn's Connections.csv. It should have First Name, Last Name, and Company columns.");
          return;
        }
        if (!people.length) {
          showError('The file has no connections in it yet. Add a few people on LinkedIn, then export again.');
          return;
        }
        start(people, false, load('sb-bf-targets', []));
      };
      reader.onerror = function () { showError("That file couldn't be read. Try choosing it again."); };
      reader.readAsText(f);
    }

    els.file.addEventListener('change', function () { readFile(els.file.files[0]); els.file.value = ''; });
    ['dragenter', 'dragover'].forEach(function (ev) {
      els.drop.addEventListener(ev, function (e) { e.preventDefault(); els.drop.classList.add('is-over'); });
    });
    ['dragleave', 'drop'].forEach(function (ev) {
      els.drop.addEventListener(ev, function (e) { e.preventDefault(); els.drop.classList.remove('is-over'); });
    });
    els.drop.addEventListener('drop', function (e) { readFile(e.dataTransfer.files[0]); });

    els.form.addEventListener('submit', function (e) {
      e.preventDefault();
      addTarget(els.input.value);
      els.input.value = '';
    });

    els.clear.addEventListener('click', function () {
      state = { people: [], targets: [], chat: [], isSample: false };
      els.results.hidden = true;
      window.scrollTo({ top: 0, behavior: 'smooth' });
      els.file.click();
    });

    // ---- sample data: fictional people, so anyone can see it work ---------------
    var SAMPLE = [
