---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import siteConfig from '../config.json';
import catalog from '../data/resources.json';

// Only groups that actually contain a published resource become tiles, so every
// tile has a real destination with real results behind it.
const published = catalog.resources.filter((r: any) => r.status === 'published');
const findGroups = catalog.groups
  .filter((g: any) => g.id !== 'all')
  .map((g: any) => ({
    ...g,
    count: published.filter((r: any) => r.group === g.id).length,
  }))
  .filter((g: any) => g.count > 0);
---

<BaseLayout title="SkillBridge — the professional skills school skips">
  <!-- HERO -->
  <section class="hero">
    <div class="hero__motif motif" aria-hidden="true"><img src="/brand/icon.webp" alt="" /></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow reveal">By two high schoolers · {siteConfig.handle}</p>
        <h1 class="hero__title reveal" data-delay="1">The professional skills school skips.</h1>
        <p class="hero__sub lead reveal" data-delay="2">
          Two high schoolers teaching the stuff that actually moves you forward — LinkedIn, resumes,
          interviewing, networking, and college prep. Free, no paywalls.
        </p>
        <div class="hero__cta reveal" data-delay="3">
          <Button href="#newsletter" variant="primary" size="lg">Join the Brief</Button>
          <Button href="/resources" variant="outline" size="lg">Browse free resources</Button>
        </div>
        <ul class="hero__chips reveal" data-delay="4">
          <li>100% free</li>
          <li>No credit card</li>
          <li>Checked June 2026</li>
        </ul>
      </div>

      <div class="hero__media reveal" data-delay="2">
        <div class="hero__portraits">
          <figure class="portrait">
            <div class="portrait__frame">
              <img
                class="portrait__img"
                src="/brand/skyler.webp"
                srcset="/brand/skyler-640.webp 640w, /brand/skyler.webp 1000w"
                sizes="(max-width: 860px) 48vw, 255px"
                alt="Skyler, co-founder of SkillBridge"
                width="1000"
                height="1250"
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption class="portrait__cap">Skyler, co-founder</figcaption>
          </figure>
          <figure class="portrait">
            <div class="portrait__frame">
              <img
                class="portrait__img"
                src="/brand/david.webp"
                srcset="/brand/david-640.webp 640w, /brand/david.webp 1000w"
                sizes="(max-width: 860px) 48vw, 255px"
                alt="David, co-founder of SkillBridge"
                width="1000"
                height="1250"
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption class="portrait__cap">David, co-founder</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU'LL FIND HERE -->
  <section class="section find">
    <div class="container">
      <div class="find__head">
        <p class="eyebrow reveal">What you'll find here</p>
        <h2 class="reveal" data-delay="1">A short, honest list of what actually works.</h2>
        <p class="lead reveal" data-delay="2">
          No fluff, no gatekeeping. The same free tools and moves we used to land internships and
          build a network, sorted so you can start today.
        </p>
      </div>
      <ul class="find__grid">
        {
          findGroups.map((g: any, i: number) => (
            <li class="find__item reveal" data-delay={String((i % 3) + 1)}>
              <a class="find__card" href={`/resources?group=${g.id}`}>
                <span class="find__label">{g.label}</span>
                <span class="find__count">
                  {g.count} {g.count === 1 ? 'resource' : 'resources'}
                </span>
                <span class="find__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="find__more reveal">
        <Button href="/resources" variant="outline">Browse free resources →</Button>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA BAND -->
  <section class="cta-band">
    <div class="cta-band__motif motif" aria-hidden="true"><img src="/brand/icon.webp" alt="" loading="lazy" decoding="async" /></div>
    <div class="container cta-band__inner">
      <h2 class="cta-band__title reveal">Start with the free resources.</h2>
      <p class="cta-band__sub reveal" data-delay="1">Eight guides and templates. Nothing costs money.</p>
      {/* One action here. The newsletter band directly below is the page's
          conversion endpoint, so a second CTA in this band would compete with it. */}
      <div class="cta-band__btns reveal" data-delay="2">
        <Button href="/resources" variant="primary" size="lg">Browse free resources</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 95% at 88% -20%, var(--light) 0%, #fff 62%);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.75rem, 2rem + 5vw, 5.5rem) clamp(2.5rem, 2rem + 4vw, 4.5rem);
  }
  .hero__motif {
    top: -8%;
    right: -5%;
    width: min(46vw, 540px);
    aspect-ratio: 1;
    opacity: 0.06;
    transform: rotate(-6deg);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .hero__copy { max-width: 620px; }
  .hero__title { margin-top: 0.7rem; font-size: clamp(2.4rem, 1.55rem + 3vw, 3.6rem); }
  .hero__sub { margin-top: 1.2rem; max-width: 46ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.9rem; }
  .hero__chips { display: flex; flex-wrap: wrap; gap: 0.5rem 0.6rem; margin-top: 1.5rem; }
  .hero__chips li {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--navy);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.4rem 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    box-shadow: var(--shadow-sm);
  }
  .hero__chips li::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
  }

  .hero__media { display: flex; justify-content: center; }
  .hero__portraits {
    display: flex;
    justify-content: center;
    gap: clamp(0.8rem, 2vw, 1.4rem);
    width: 100%;
  }
  .portrait { position: relative; width: 100%; max-width: 360px; margin: 0; }
  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: linear-gradient(160deg, var(--surface-tint), #fff 72%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .portrait__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
  }
  .portrait__cap {
    margin-top: 0.85rem;
    text-align: center;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  /* when David's portrait is added, the pair auto-sizes to sit side by side */
  .hero__portraits:has(.portrait + .portrait) .portrait { max-width: 255px; }

  @media (max-width: 860px) {
    .hero__inner { grid-template-columns: 1fr; gap: 2.25rem; }
    .hero__media { justify-content: center; }
    .portrait { max-width: 300px; }
    .hero__portraits:has(.portrait + .portrait) .portrait { max-width: 48%; }
  }

  /* ---------------- FIND ---------------- */
  .find__head { max-width: 660px; }
  .find__head h2 { margin-top: 0.4rem; }
  .find__head .lead { margin-top: 0.85rem; }
  .find__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(225px, 1fr));
    gap: 1rem;
    margin-top: 2.2rem;
  }
  .find__item { display: flex; }
  /* A real link into the filtered library, so the hover state is now describing
     something that actually happens when you click. */
  .find__card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    min-height: 44px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.05rem 1.2rem;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: transform 0.16s var(--ease), box-shadow 0.16s ease, border-color 0.16s ease;
  }
  /* Focus gets the same response as hover — a keyboard user should see the tile
     react, not just the ring. */
  .find__card:hover,
  .find__card:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--blue);
  }
  .find__label {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.22;
  }
  .find__count {
    margin-left: auto;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .find__go {
    flex: none;
    font-family: var(--font-head);
    font-weight: 800;
    color: var(--blue-ink);
    transition: transform 0.16s var(--ease);
  }
  .find__card:hover .find__go,
  .find__card:focus-visible .find__go { transform: translateX(3px); }
  .find__more { margin-top: 1.8rem; }

  /* ---------------- CTA BAND ---------------- */
  .cta-band {
    position: relative;
    overflow: hidden;
    background: var(--surface-tint);
    border-top: 1px solid var(--line);
    color: var(--ink);
  }
  .cta-band__motif {
    top: 50%;
    right: -4%;
    width: min(40vw, 420px);
    aspect-ratio: 1;
    transform: translateY(-50%) rotate(-6deg);
    opacity: 0.07;
  }
  .cta-band__inner {
    padding-block: clamp(3rem, 2rem + 5vw, 5.5rem);
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .cta-band__title { color: var(--navy); }
  .cta-band__sub {
    margin-top: 0.7rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }
  .cta-band__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 1.9rem;
  }
</style>
