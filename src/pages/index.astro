---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import NewsletterSlot from '../components/NewsletterSlot.astro';
import siteConfig from '../config.json';
import toolkit from '../data/toolkit.json';

const categories = toolkit.sections.map((s) => ({ n: s.n, title: s.title }));
---

<BaseLayout title="SkillBridge — the professional skills school skips">
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">By two high schoolers · {siteConfig.handle}</p>
      <h1 class="hero__title">The professional skills school skips.</h1>
      <p class="hero__sub lead">
        Two high schoolers teaching the stuff that actually moves you forward — LinkedIn, resumes,
        interviewing, networking, and college prep. Free, no paywalls.
      </p>
      <div class="hero__cta">
        <Button href="/resources" variant="primary" size="lg">Get the free toolkit</Button>
        <Button href={siteConfig.discordUrl} variant="discord" size="lg" external>Join the Discord</Button>
      </div>
      <p class="hero__note">Genuinely free tools, checked June 2026 — no trials that charge you in two weeks.</p>
    </div>
  </section>

  <!-- WHAT YOU'LL FIND HERE -->
  <section class="section find">
    <div class="container">
      <div class="find__head">
        <p class="eyebrow">What you'll find here</p>
        <h2>A short, honest list of what actually works.</h2>
        <p class="lead">
          No fluff, no gatekeeping. The same free tools and moves we used to land internships and
          build a network, sorted so you can start today.
        </p>
      </div>
      <ul class="find__grid">
        {
          categories.map((c) => (
            <li class="find__card">
              <span class="find__num" aria-hidden="true">{c.n}</span>
              <span class="find__label">{c.title}</span>
            </li>
          ))
        }
      </ul>
      <div class="find__more">
        <Button href="/resources" variant="outline">See everything we use →</Button>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER SLOT (phase-2 affordance, no capture) -->
  <div class="container"><NewsletterSlot /></div>

  <!-- CLOSING CTA BAND -->
  <section class="cta-band">
    <div class="container cta-band__inner">
      <h2 class="cta-band__title">Start with the free toolkit.</h2>
      <p class="cta-band__sub">Then come hang out in the Discord, where a new free tool drops every week.</p>
      <div class="cta-band__btns">
        <Button href="/resources" variant="light" size="lg">Get the free toolkit</Button>
        <Button href={siteConfig.discordUrl} variant="discord" size="lg" external>Join the Discord</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: radial-gradient(120% 90% at 82% -10%, var(--light) 0%, #fff 58%);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(3rem, 2rem + 6vw, 6rem) clamp(2.5rem, 2rem + 4vw, 4.5rem);
  }
  .hero__inner { max-width: 820px; }
  .hero__title { margin-top: 0.6rem; }
  .hero__sub { margin-top: 1.1rem; max-width: 48ch; }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }
  .hero__note {
    margin-top: 1.15rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .find__head { max-width: 640px; }
  .find__head h2 { margin-top: 0.4rem; }
  .find__head .lead { margin-top: 0.8rem; }
  .find__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(225px, 1fr));
    gap: 1rem;
    margin-top: 2.1rem;
  }
  .find__card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.14s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }
  .find__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--line-strong);
  }
  .find__num {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--surface-tint);
    color: var(--blue-ink);
    font-family: var(--font-head);
    font-weight: 800;
  }
  .find__label {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.22;
  }
  .find__more { margin-top: 1.7rem; }

  .cta-band {
    background: linear-gradient(135deg, var(--navy), var(--dark));
    color: #fff;
  }
  .cta-band__inner {
    padding-block: clamp(3rem, 2rem + 5vw, 5rem);
    text-align: center;
  }
  .cta-band__title { color: #fff; }
  .cta-band__sub {
    margin-top: 0.8rem;
    color: rgba(235, 244, 252, 0.82);
    max-width: 48ch;
    margin-inline: auto;
  }
  .cta-band__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 1.8rem;
  }
</style>
