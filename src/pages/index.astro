---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import HeroBridge from '../components/HeroBridge.astro';
import catalog from '../data/resources.json';

// Only groups that actually contain a published resource become tiles, so every
// tile has a real destination with real results behind it.
const published = catalog.resources.filter((r: any) => r.status === 'published');
const findGroups = catalog.groups
  .filter((g: any) => g.id !== 'all')
  .map((g: any) => ({
    ...g,
    count: published.filter((r: any) => r.group === g.id).length,
  }))
  .filter((g: any) => g.count > 0);
---

<BaseLayout title="SkillBridge — the professional skills school skips">
  <!-- HERO -->
  {/* Hero motion is choreographed in src/scripts/motion.ts (data-hero marks the
      pieces). The bridge replaces the old faint logo motif: same image, now built. */}
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 class="hero__title" data-hero="title">The professional skills school skips.</h1>
        <p class="hero__sub lead" data-hero="fade">
          Two high schoolers teaching the stuff that actually moves you forward — LinkedIn, resumes,
          interviewing, networking, and college prep. Free, no paywalls.
        </p>
        <div class="hero__cta" data-hero="fade">
          <Button href="#newsletter" variant="primary" size="lg">Join the Brief</Button>
          <Button href="/resources" variant="outline" size="lg">Browse free resources</Button>
        </div>
        <p class="hero__note" data-hero="fade">No credit card. Last checked June 2026.</p>
      </div>

      <div class="hero__media">
        <div class="hero__portraits">
          <figure class="portrait">
            <div class="portrait__frame">
              <img
                class="portrait__img"
                src="/brand/skyler.webp"
                srcset="/brand/skyler-640.webp 640w, /brand/skyler.webp 1000w"
                sizes="(max-width: 860px) 48vw, 255px"
                alt="Skyler, co-founder of SkillBridge"
                width="1000"
                height="1250"
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption class="portrait__cap">Skyler, co-founder</figcaption>
          </figure>
          <figure class="portrait">
            <div class="portrait__frame">
              <img
                class="portrait__img"
                src="/brand/david.webp"
                srcset="/brand/david-640.webp 640w, /brand/david.webp 1000w"
                sizes="(max-width: 860px) 48vw, 255px"
                alt="David, co-founder of SkillBridge"
                width="1000"
                height="1250"
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption class="portrait__cap">David, co-founder</figcaption>
          </figure>
        </div>
      </div>
    </div>
    <div class="container hero__bridge">
      <HeroBridge />
    </div>
  </section>

  <!-- WHAT YOU'LL FIND HERE -->
  <section class="section find">
    <div class="container">
      <div class="find__head">
        <h2 class="reveal" data-delay="1">A short, honest list of what actually works.</h2>
        <p class="lead reveal" data-delay="2">
          No fluff, no gatekeeping. The same free tools and moves we used to land internships and
          build a network, sorted so you can start today.
        </p>
      </div>
      {/* Rows, not tiles: the same hairline list and navy deck line the resource
          library uses, so the home page and the library read as one system. */}
      <ul class="find__list">
        {
          findGroups.map((g: any, i: number) => (
            <li class="reveal" data-delay={String((i % 3) + 1)}>
              <a class="find__row" href={`/resources?group=${g.id}`}>
                <span class="find__label">{g.label}</span>
                <span class="find__count">
                  {g.count} {g.count === 1 ? 'resource' : 'resources'}
                </span>
                <svg class="find__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="find__more reveal">
        <Button href="/resources" variant="outline">Browse all free resources</Button>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA BAND -->
  <section class="cta-band">
    <div class="cta-band__motif motif" aria-hidden="true"><img src="/brand/icon.webp" alt="" loading="lazy" decoding="async" /></div>
    <div class="container cta-band__inner">
      <h2 class="cta-band__title reveal">Start with the free resources.</h2>
      <p class="cta-band__sub reveal" data-delay="1">Eight guides and templates. Nothing costs money.</p>
      {/* One action here. The newsletter band directly below is the page's
          conversion endpoint, so a second CTA in this band would compete with it. */}
      <div class="cta-band__btns reveal" data-delay="2">
        <Button href="/resources" variant="primary" size="lg">Browse free resources</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 95% at 88% -20%, var(--light) 0%, #fff 62%);
    border-bottom: 1px solid var(--line);
    padding-top: clamp(2.75rem, 2rem + 5vw, 5.5rem);
  }
  /* The bridge is the hero's horizon: its deck sits just above the section's
     bottom border, under both the copy and the founders. */
  .hero__bridge { margin-top: clamp(1.25rem, 0.5rem + 3vw, 2.5rem); }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .hero__copy { max-width: 620px; }
  .hero__title { font-size: clamp(2.4rem, 1.55rem + 3vw, 3.6rem); }
  .hero__sub { margin-top: 1.2rem; max-width: 46ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.9rem; }
  /* The "100% free" part already lives in the subhead; this line only adds what
     it doesn't say, as plain text instead of three badge pills. */
  .hero__note {
    margin-top: 1.35rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .hero__media { display: flex; justify-content: center; }
  .hero__portraits {
    display: flex;
    justify-content: center;
    gap: clamp(0.8rem, 2vw, 1.4rem);
    width: 100%;
  }
  .portrait { position: relative; width: 100%; max-width: 360px; margin: 0; }
  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: linear-gradient(160deg, var(--surface-tint), #fff 72%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .portrait__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
  }
  .portrait__cap {
    margin-top: 0.85rem;
    text-align: center;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  /* when David's portrait is added, the pair auto-sizes to sit side by side */
  .hero__portraits:has(.portrait + .portrait) .portrait { max-width: 255px; }

  @media (max-width: 860px) {
    .hero__inner { grid-template-columns: 1fr; gap: 2.25rem; }
    .hero__media { justify-content: center; }
    .portrait { max-width: 300px; }
    .hero__portraits:has(.portrait + .portrait) .portrait { max-width: 48%; }
  }

  /* ---------------- FIND ---------------- */
  .find__head { max-width: 660px; }
  .find__head .lead { margin-top: 0.85rem; }
  .find__list {
    max-width: 660px;
    margin-top: 2rem;
    border-bottom: 1px solid var(--line);
  }
  /* A real link into the filtered library. Hover and keyboard focus both draw the
     navy deck line under the row, the same cue the library rows use. */
  .find__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    padding: 0.9rem 0.1rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .find__row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--navy);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.26s var(--ease);
  }
  .find__row:hover::after,
  .find__row:focus-visible::after { transform: scaleX(1); }
  .find__label {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--navy);
    line-height: 1.22;
    transition: color 0.16s var(--ease);
  }
  .find__row:hover .find__label { color: var(--blue-ink); }
  .find__count {
    margin-left: auto;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .find__go {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--blue-ink);
    transition: transform 0.16s var(--ease);
  }
  .find__row:hover .find__go,
  .find__row:focus-visible .find__go { transform: translateX(3px); }
  .find__more { margin-top: 1.8rem; }

  /* ---------------- CTA BAND ---------------- */
  .cta-band {
    position: relative;
    overflow: hidden;
    background: var(--surface-tint);
    border-top: 1px solid var(--line);
    color: var(--ink);
  }
  .cta-band__motif {
    top: 50%;
    right: -4%;
    width: min(40vw, 420px);
    aspect-ratio: 1;
    transform: translateY(-50%) rotate(-6deg);
    opacity: 0.07;
  }
  .cta-band__inner {
    padding-block: clamp(3rem, 2rem + 5vw, 5.5rem);
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .cta-band__title { color: var(--navy); }
  .cta-band__sub {
    margin-top: 0.7rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }
  .cta-band__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 1.9rem;
  }
</style>
