---
// Official SkillBridge wordmark (book+bridge icon + "SkillBridge").
// variant="navy"  -> for light backgrounds (header, light sections)
// variant="white" -> for dark backgrounds (footer). Real alpha-masked asset,
// generated by scripts/process-logos.mjs, so it stays crisp (no CSS filter).
interface Props {
  variant?: 'navy' | 'white';
  href?: string;
  class?: string;
}
const { variant = 'navy', href = '/', class: className = '' } = Astro.props;
// The *-web.png copies are sized for the 34px header (~3x); the full-size PNGs are
// kept for the PDF and OG-card scripts.
const src = variant === 'white' ? '/brand/wordmark-white-web.png' : '/brand/wordmark-web.png';
---

<a class:list={['logo', className]} href={href} aria-label="SkillBridge — home">
  <img class="logo__img" src={src} alt="SkillBridge" width="583" height="120" decoding="async" />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .logo__img {
    height: 34px;
    width: auto;
    display: block;
  }
  @media (max-width: 640px) {
    .logo__img { height: 29px; }
  }
</style>
