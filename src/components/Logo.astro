---
interface Props {
  variant?: 'light' | 'dark';
  href?: string;
  class?: string;
}
const { variant = 'light', href = '/', class: className = '' } = Astro.props;
const deck = variant === 'dark' ? '#EBF4FC' : '#1B3A6B';
---

<a class:list={['logo', `logo--${variant}`, className]} href={href} aria-label="SkillBridge — home">
  <svg
    class="logo__mark"
    viewBox="0 0 40 28"
    width="36"
    height="25"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M4 21 Q20 3 36 21" stroke="#5BB8F5" stroke-width="3" />
    <line x1="3" y1="21.5" x2="37" y2="21.5" stroke={deck} stroke-width="3" />
    <line x1="13" y1="14" x2="13" y2="21.5" stroke={deck} stroke-width="2.3" />
    <line x1="20" y1="10.5" x2="20" y2="21.5" stroke={deck} stroke-width="2.3" />
    <line x1="27" y1="14" x2="27" y2="21.5" stroke={deck} stroke-width="2.3" />
  </svg>
  <span class="logo__word">SkillBridge</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  .logo__word {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .logo--light .logo__word { color: var(--navy); }
  .logo--dark .logo__word { color: #fff; }
  .logo:hover .logo__word { opacity: 0.82; }
</style>
