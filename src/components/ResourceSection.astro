---
interface Props {
  n: number;
  title: string;
}
const { n, title } = Astro.props;
---

<section class="r-section">
  <div class="r-section__head">
    <span class="r-section__num" aria-hidden="true">{n}</span>
    <h2 class="r-section__title">{title}</h2>
  </div>
  <ul class="r-section__items">
    <slot />
  </ul>
</section>

<style>
  .r-section {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 1rem + 1.5vw, 1.9rem);
    box-shadow: var(--shadow-sm);
  }
  .r-section + :global(.r-section) { margin-top: 1.25rem; }
  .r-section__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.4rem;
  }
  .r-section__num {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.05rem;
  }
  .r-section__title {
    font-size: var(--step-1);
    font-weight: 700;
    margin: 0;
  }
  .r-section__items {
    display: flex;
    flex-direction: column;
  }
</style>
