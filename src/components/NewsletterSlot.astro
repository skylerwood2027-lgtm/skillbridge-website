---
// The SkillBridge Brief — official Beehiiv embed, framed as an editorial masthead.
//
// The form's own type (a serif theme) and internal padding are set in the Beehiiv
// dashboard and render inside a cross-origin iframe, so they can't be restyled from
// here. Two things we CAN own from code: the branded frame around it, and its
// responsiveness. The Beehiiv form only lays out cleanly at >=420px wide (below that
// its title wraps into a narrow column and the email field's placeholder clips). So we
// render it at a fixed 420px "design width" and scale the whole frame down to fit
// narrower screens — identical, unbroken layout everywhere, no clipping, text scaled
// proportionally.
const FORM_ID = '1bfc13e5-f4f0-4ff4-a186-458a23a90916';
---

<section class="newsletter" aria-label="The SkillBridge Brief newsletter signup">
  <div class="newsletter__card">
    <p class="newsletter__kicker">Free newsletter</p>
    <div class="newsletter__stage" data-embed-stage>
      <div class="newsletter__embed" data-embed>
        <script
          is:inline
          async
          src="https://subscribe-forms.beehiiv.com/v3/loader.js"
          data-beehiiv-form={FORM_ID}
        ></script>
        <noscript>Enable JavaScript to subscribe to The SkillBridge Brief.</noscript>
      </div>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement for the cross-origin Beehiiv form, which only lays out
  // cleanly at >=400px wide. Two modes:
  //   - Room to spare (desktop/tablet): render the form fluidly at its natural width
  //     (capped), no transform — crisp, edge-to-edge type.
  //   - Too narrow (phones): pin it to the 400px design width and scale the whole frame
  //     down to fit, so the internal layout never cramps. No clipping; type scales too.
  // Without JS the embed just flows fluidly — degraded but never broken or overflowing.
  const MIN_CLEAN = 420; // narrowest width at which the form stays uncramped (measured: the email field's placeholder clips below ~415px)
  const MAX_WIDTH = 460; // don't let it grow so wide it looks sparse

  const stage = document.querySelector<HTMLElement>('[data-embed-stage]');
  const embed = stage?.querySelector<HTMLElement>('[data-embed]');
  if (stage && embed) {
    stage.classList.add('is-enhanced');

    let lastH = -1;
    let lastW = -1;
    let lastS = -1;
    const fit = () => {
      const iframe = embed.querySelector('iframe');
      const avail = stage.clientWidth;
      const width = avail >= MIN_CLEAN ? Math.min(avail, MAX_WIDTH) : MIN_CLEAN;
      const scale = avail >= MIN_CLEAN ? 1 : avail / MIN_CLEAN;
      if (width !== lastW) {
        stage.style.setProperty('--embed-w', width + 'px');
        lastW = width;
      }
      if (scale !== lastS) {
        stage.style.setProperty('--embed-s', scale.toFixed(4));
        lastS = scale;
      }
      if (iframe) {
        if (!iframe.getAttribute('title')) {
          iframe.setAttribute('title', 'Subscribe to The SkillBridge Brief newsletter');
        }
        void iframe.offsetWidth; // force reflow so offsetHeight reflects the new width
        const h = Math.ceil(iframe.offsetHeight * scale); // offsetHeight = untransformed
        if (h > 0 && h !== lastH) {
          stage.style.height = h + 'px';
          lastH = h;
        }
      }
    };

    // React to the container getting wider/narrower...
    new ResizeObserver(fit).observe(stage);
    // ...to the iframe being injected by the loader and to its height updates.
    const frameRO = new ResizeObserver(fit);
    let watching: Element | null = null;
    const mo = new MutationObserver(() => {
      const iframe = embed.querySelector('iframe');
      if (iframe && iframe !== watching) {
        watching = iframe;
        frameRO.observe(iframe);
      }
      fit();
    });
    mo.observe(embed, { childList: true, subtree: true, attributes: true, attributeFilter: ['style'] });
    fit();
  }
</script>

<style>
  .newsletter { padding-block: clamp(1rem, 0.5rem + 2vw, 2rem); }

  .newsletter__card {
    max-width: 500px;
    margin-inline: auto;
    background: var(--surface-tint);
    border: 1px solid var(--line);
    border-top: 3px solid var(--navy); /* editorial masthead rule */
    border-radius: var(--radius-lg);
    /* A thin, even mat around the form. The Beehiiv card supplies its own generous
       inner padding, so ours stays tight — the white form is the hero, not a box in a
       box. Bottom is lightest because the form already leaves room below the field. */
    padding: clamp(0.85rem, 0.6rem + 1vw, 1.25rem) clamp(0.7rem, 0.4rem + 1.2vw, 1.25rem)
      clamp(0.4rem, 0.2rem + 0.8vw, 0.7rem);
    text-align: center;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(27, 58, 107, 0.08);
  }

  .newsletter__kicker {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-ink);
    margin: 0 0 0.4rem;
  }

  /* The scaling stage. Default (no-JS) state: the embed flows naturally and fills the
     card fluidly — degraded but never clipped or overflowing. */
  .newsletter__stage {
    position: relative;
    width: 100%;
    min-height: 340px;
  }

  /* Enhanced state: the embed is pinned to the design width and scaled to fit. Absolute
     positioning keeps the fixed-width box out of flow so it can't force a horizontal
     scrollbar; the stage's JS-set height reserves the scaled footprint. */
  .newsletter__stage.is-enhanced { min-height: 0; }
  .newsletter__stage.is-enhanced .newsletter__embed {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--embed-w, 420px);
    transform: translateX(-50%) scale(var(--embed-s, 1));
    transform-origin: top center;
  }
</style>
