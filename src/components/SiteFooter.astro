---
import Logo from './Logo.astro';
import siteConfig from '../config.json';

const year = new Date().getFullYear();
const socials = [
  { label: 'Instagram', href: siteConfig.instagramUrl },
  { label: 'TikTok', href: siteConfig.tiktokUrl },
  { label: 'YouTube', href: siteConfig.youtubeUrl },
  { label: 'Discord', href: siteConfig.discordUrl },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <Logo variant="white" href="/" />
    <nav class="site-footer__links" aria-label="Footer">
      <ul class="site-footer__group">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
            </li>
          ))
        }
      </ul>
      <ul class="site-footer__group">
        <li><a href="/resources">Free resources</a></li>
        <li><a href="/our-story">Our story</a></li>
      </ul>
    </nav>
    <p class="site-footer__copy">© {year} SkillBridge</p>
  </div>
</footer>

<style>
  .site-footer {
    --focus-ring: var(--blue);
    background: var(--dark);
    color: #fff;
    margin-top: auto;
  }
  .site-footer__inner {
    display: grid;
    gap: 1.25rem;
    padding-block: 2.5rem 2rem;
  }
  .site-footer__links {
    display: grid;
    gap: 0.25rem clamp(1.5rem, 4vw, 3.5rem);
  }
  .site-footer__group {
    display: flex;
    flex-wrap: wrap;
    column-gap: clamp(1rem, 2.4vw, 1.75rem);
  }
  .site-footer__group a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .site-footer__group a:hover {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .site-footer__copy {
    color: var(--white-74);
    font-size: 0.9375rem;
  }

  @media (min-width: 56.25rem) {
    .site-footer__inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 3rem;
      padding-block: 2.25rem;
    }
    .site-footer__links {
      grid-auto-flow: column;
      justify-content: start;
    }
  }
</style>
