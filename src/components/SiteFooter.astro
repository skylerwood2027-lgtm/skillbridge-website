---
import Logo from './Logo.astro';
import siteConfig from '../config.json';

const year = new Date().getFullYear();
const socials = [
  { label: 'Instagram', href: siteConfig.instagramUrl, icon: 'instagram' },
  { label: 'TikTok', href: siteConfig.tiktokUrl, icon: 'tiktok' },
  { label: 'YouTube', href: siteConfig.youtubeUrl, icon: 'youtube' },
];
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <Logo variant="white" href="/" />
      <p class="site-footer__tag">The professional skills school skips, taught for free by two high schoolers.</p>
      <div class="site-footer__socials">
        {
          socials.map((s) => (
            <a
              class="social"
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`SkillBridge on ${s.label} (${siteConfig.handle})`}
            >
              {s.icon === 'instagram' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2" />
                  <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="2" />
                  <circle cx="17.3" cy="6.7" r="1.3" fill="currentColor" />
                </svg>
              )}
              {s.icon === 'tiktok' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
                  <path d="M14 3v9.8a3.6 3.6 0 1 1-3.1-3.57" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M14 3.2c.45 2.7 2.1 4.4 4.8 4.7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {s.icon === 'youtube' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
                  <rect x="2" y="5" width="20" height="14" rx="4.5" stroke="currentColor" stroke-width="2" />
                  <path d="M10.2 9.1l4.8 2.9-4.8 2.9z" fill="currentColor" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
      <p class="site-footer__handle">{siteConfig.handle}</p>
    </div>

    <div class="site-footer__cta">
      <p class="site-footer__cta-line">New guides go out in The SkillBridge Brief.</p>
      {/* A text link, not a second button — the newsletter band sits directly above
          this footer on every page, and two buttons would compete. */}
      <p class="site-footer__community">
        <a class="site-footer__brief" href="#newsletter">Sign up for The Brief</a>
      </p>
      <p class="site-footer__community">
        Or come talk to us in the <a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">SkillBridge Discord</a>.
      </p>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/resources">Resources</a>
      <a href="#newsletter">Newsletter</a>
      <a href="/our-story">Our Story</a>
    </nav>
    <p class="site-footer__copy">© {year} SkillBridge</p>
  </div>
</footer>

<style>
  .site-footer {
    --focus-ring: var(--blue);
    background: var(--dark);
    color: var(--light);
    margin-top: auto;
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    align-items: flex-start;
    justify-content: space-between;
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 3.5rem);
  }
  .site-footer__brand { max-width: 30rem; }
  .site-footer__tag {
    margin-top: 0.9rem;
    color: rgba(235, 244, 252, 0.75);
    font-size: 0.97rem;
    line-height: 1.55;
  }
  .site-footer__socials {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }
  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(91, 184, 245, 0.35);
    color: var(--light);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .social:hover {
    background: var(--blue);
    color: var(--dark);
    border-color: var(--blue);
  }
  .site-footer__handle {
    margin-top: 0.85rem;
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--blue);
    letter-spacing: -0.01em;
  }
  .site-footer__cta-line {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
    color: #fff;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
    border-top: 1px solid rgba(91, 184, 245, 0.2);
  }
  .site-footer__nav {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  .site-footer__nav a {
    color: rgba(235, 244, 252, 0.82);
    text-decoration: none;
    font-size: 0.94rem;
    font-family: var(--font-head);
    font-weight: 600;
  }
  .site-footer__nav a:hover { color: var(--blue); }
  .site-footer__copy {
    color: rgba(235, 244, 252, 0.6);
    font-size: 0.9rem;
  }
  .site-footer__brief {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.97rem;
    color: var(--blue);
    text-decoration-color: rgba(91, 184, 245, 0.5);
  }
  .site-footer__brief:hover { color: #fff; }
  /* Discord stays available, as one line of text rather than a second button. */
  .site-footer__community {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    color: rgba(235, 244, 252, 0.72);
  }
  .site-footer__community a { color: var(--blue); text-decoration-color: rgba(91, 184, 245, 0.5); }
  .site-footer__community a:hover { color: #fff; }
</style>
