---
// The Brief: the email signup, on the navy band that closes every page.
//
// It starts as a plain link to the hosted Beehiiv form, which works with no
// JavaScript and when a content blocker stops the embed. When the band is about
// to scroll into view the same form is embedded in place, and once it has
// loaded it takes over from the link.
//
// The embedded form is a cross-origin iframe whose type and padding are set in
// the Beehiiv dashboard and cannot be restyled from here. Two things we own: the
// frame around it, and its responsiveness. The form only lays out cleanly at
// >=420px wide (below that its title wraps and the email placeholder clips), so
// below that width we pin it to that design width and scale the whole frame down.
// That measured behaviour is carried over unchanged from the previous band.
const FORM_ID = '1bfc13e5-f4f0-4ff4-a186-458a23a90916';
const FORM_URL = `https://subscribe-forms.beehiiv.com/v3/forms/${FORM_ID}`;

interface Props {
  /** Heading level so the band never breaks a page's heading order. */
  as?: 'h2' | 'h3';
}
const { as: Tag = 'h2' } = Astro.props;
---

<section class="brief" id="brief" aria-labelledby="brief-heading" data-brief>
  {/* Older links on the other pages still point at #newsletter. */}
  <span class="brief__anchor" id="newsletter"></span>
  <div class="container brief__inner">
    <div class="brief__copy">
      <Tag class="display brief__title" id="brief-heading">New guides, <i class="serif">first</i>.</Tag>
      <p class="brief__line">One short email when we make something new. Unsubscribe anytime.</p>
    </div>

    <div class="brief__action">
      <a class="sb-btn sb-btn--ondark brief__link" href={FORM_URL}>Get new guides by email</a>
      <div class="brief__form">
        <div class="brief__stage" data-embed-stage>
          <div class="brief__embed" data-embed data-beehiiv-id={FORM_ID}></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement for the cross-origin Beehiiv form. Same fitting logic
  // as before: the measured 420px floor still governs the embed.
  const MIN_CLEAN = 420; // narrowest width at which the form stays uncramped
  const MAX_WIDTH = 520; // wide enough that its button label stays on one line, no wider

  const band = document.querySelector<HTMLElement>('[data-brief]');
  const stage = band?.querySelector<HTMLElement>('[data-embed-stage]');
  const embed = stage?.querySelector<HTMLElement>('[data-embed]');
  if (band && stage && embed) {
    stage.classList.add('is-enhanced');

    let lastH = -1;
    let lastW = -1;
    let lastS = -1;
    const fit = () => {
      const iframe = embed.querySelector('iframe');
      const avail = stage.clientWidth;
      const width = avail >= MIN_CLEAN ? Math.min(avail, MAX_WIDTH) : MIN_CLEAN;
      const scale = avail >= MIN_CLEAN ? 1 : avail / MIN_CLEAN;
      if (width !== lastW) {
        stage.style.setProperty('--embed-w', width + 'px');
        lastW = width;
      }
      if (scale !== lastS) {
        stage.style.setProperty('--embed-s', scale.toFixed(4));
        lastS = scale;
      }
      if (iframe) {
        if (!iframe.getAttribute('title')) {
          iframe.setAttribute('title', 'Subscribe to The SkillBridge Brief newsletter');
        }
        void iframe.offsetWidth; // force reflow so offsetHeight reflects the new width
        const h = Math.ceil(iframe.offsetHeight * scale); // offsetHeight = untransformed
        if (h > 0 && h !== lastH) {
          stage.style.height = h + 'px';
          lastH = h;
        }
      }
    };

    new ResizeObserver(fit).observe(stage);
    const frameRO = new ResizeObserver(fit);
    let watching: Element | null = null;
    const mo = new MutationObserver(() => {
      const iframe = embed.querySelector('iframe');
      if (iframe && iframe !== watching) {
        watching = iframe;
        frameRO.observe(iframe);
        // The form has arrived: it replaces the link.
        iframe.addEventListener(
          'load',
          () => {
            band.classList.add('is-live');
            fit();
          },
          { once: true },
        );
      }
      fit();
    });
    mo.observe(embed, { childList: true, subtree: true, attributes: true, attributeFilter: ['style'] });
    fit();

    // The Beehiiv loader pulls ~800 KB of script, and this band sits at the bottom
    // of every page. Inject it only when the band is about to scroll into view.
    // The loader finds its own <script data-beehiiv-form> at run time and inserts
    // the iframe right after it, so a late-added tag behaves like the static one.
    const loadForm = () => {
      if (embed.querySelector('script[data-beehiiv-form]')) return;
      const s = document.createElement('script');
      s.src = 'https://subscribe-forms.beehiiv.com/v3/loader.js';
      s.async = true;
      s.dataset.beehiivForm = embed.dataset.beehiivId ?? '';
      embed.prepend(s);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            loadForm();
          }
        },
        { rootMargin: '500px 0px' },
      );
      io.observe(band);
    } else {
      loadForm();
    }
  }
</script>

<style>
  .brief {
    --focus-ring: var(--blue);
    background: var(--navy);
    color: #fff;
    position: relative;
  }
  .brief__anchor {
    position: absolute;
    top: 0;
  }
  .brief,
  .brief__anchor { scroll-margin-top: 4.25rem; }

  .brief__inner {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .brief__title { color: #fff; }
  .brief__line {
    margin-top: 1.25rem;
    max-width: 30ch;
    font-size: 1.1em;
    color: var(--white-74);
  }
  .brief__action { min-width: 0; }
  .brief__link { width: 100%; }

  /* The Beehiiv form ships its own white card and cannot be restyled across the
     iframe boundary. It gets one flat white panel with an even inset, so it sits
     on the navy as a deliberate sheet. Until the form has loaded the panel holds
     its width (the iframe needs it to lay out) but takes up no height and shows
     nothing, so there is never an empty white box on the page. */
  .brief__form {
    height: 0;
    overflow: hidden;
    visibility: hidden;
    border-radius: 12px;
    background: #fff;
  }
  .brief.is-live .brief__link { display: none; }
  .brief.is-live .brief__form {
    height: auto;
    padding: 0.5rem;
    visibility: visible;
  }

  .brief__stage {
    position: relative;
    width: 100%;
    min-height: 300px;
  }
  /* Enhanced state: pinned to the design width and scaled to fit. Absolute
     positioning keeps the fixed-width box out of flow so it can never force a
     horizontal scrollbar; the JS-set height reserves the scaled footprint. */
  .brief__stage.is-enhanced .brief__embed {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--embed-w, 420px);
    transform: translateX(-50%) scale(var(--embed-s, 1));
    transform-origin: top center;
  }

  @media (min-width: 30rem) {
    .brief__link { width: auto; }
  }
  @media (min-width: 60rem) {
    .brief__inner {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 536px);
      align-items: center;
      gap: 4rem;
    }
    .brief__action { text-align: right; }
    .brief__stage.is-enhanced .brief__embed {
      left: auto;
      right: 0;
      transform: scale(var(--embed-s, 1));
      transform-origin: top right;
    }
  }
</style>
