---
import Logo from './Logo.astro';
import siteConfig from '../config.json';

interface Props {
  /** The /get pages carry the wordmark only: no nav, no button. */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;

const path = Astro.url.pathname;
const onHome = path === '/';
const isActive = (href: string) => href.startsWith('/') && href.length > 1 && !href.startsWith('/#') && path.startsWith(href);
const links = [
  { href: onHome ? '#videos' : '/#videos', label: 'Videos' },
  { href: '/resources', label: 'Free resources' },
  { href: '/bridge-finder', label: 'Bridge Finder' },
  { href: '/our-story', label: 'Our story' },
];
---

<header class:list={['site-header', { 'site-header--minimal': minimal }]}>
  <div class="container site-header__inner">
    <Logo variant="navy" />
    {
      !minimal && (
        <>
          <nav class="site-nav" id="site-menu" aria-label="Primary">
            {links.map((l) => (
              <a class="site-nav__link" href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            ))}
          </nav>
          <a class="sb-btn sb-btn--primary site-header__follow" href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer">
            Follow us
          </a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
            Menu
          </button>
        </>
      )
    }
  </div>
</header>

<script is:inline>
  (function () {
    // No toggle on the minimal header, so this returns straight away there.
    var btn = document.querySelector('.nav-toggle');
    var hdr = document.querySelector('.site-header');
    var menu = document.getElementById('site-menu');
    if (!btn || !hdr || !menu) return;
    function set(open) {
      hdr.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.textContent = open ? 'Close' : 'Menu';
    }
    btn.addEventListener('click', function () {
      set(!hdr.classList.contains('is-open'));
    });
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) set(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') set(false);
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--ink-16);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 68px;
  }
  .site-nav {
    display: flex;
    margin-left: auto;
    gap: clamp(0.25rem, 1.4vw, 1.25rem);
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 0.6rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
  .site-header__follow { margin-left: clamp(0.5rem, 1.5vw, 1.25rem); }

  /* The word, not three bars: nothing to decode, and no icon to draw. */
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 48px;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    cursor: pointer;
  }

  /* The /get pages: wordmark only, and it scrolls away with the page. */
  .site-header--minimal {
    position: static;
    border-bottom: 0;
  }
  .site-header--minimal .site-header__inner { min-height: 60px; }

  @media (min-width: 56.25rem) {
    .site-header__inner { min-height: 76px; }
  }

  @media (max-width: 56.24rem) {
    .site-header__follow {
      margin-left: auto;
      padding-inline: 0.95rem;
    }
    .nav-toggle { display: inline-flex; }
    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 0.25rem var(--gutter) 1rem;
      background: var(--paper);
      border-bottom: 1px solid var(--ink-16);
    }
    .site-header.is-open .site-nav { display: flex; }
    .site-nav__link {
      min-height: 52px;
      padding-inline: 0;
      font-size: 1.125rem;
      border-bottom: 1px solid var(--ink-16);
    }
    .site-nav__link:last-child { border-bottom: 0; }
  }
</style>
