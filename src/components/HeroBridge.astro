---
// The suspension bridge from the logo, redrawn as line art in ink on paper. It
// runs the full width of the page as the seam after the dark video section, and
// is built stroke by stroke when it scrolls into view (src/scripts/motion.ts).
// Without JS or with reduced motion it simply renders finished.
//
// Geometry lives in a 1200 x 200 box: deck at y=172, towers at x=300 and x=900,
// one main span and two side spans. Hangers are computed from the same quadratic
// curves the cables use, so every hanger meets its cable exactly.
const W = 1200;
const DECK = 172;
const TOP = 30;
const T1 = 300;
const T2 = 900;

type Pt = [number, number];
const quad = (p0: Pt, p1: Pt, p2: Pt, t: number): Pt => [
  (1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * p1[0] + t ** 2 * p2[0],
  (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * p1[1] + t ** 2 * p2[1],
];
// Control x sits at the midpoint of each span, so x is linear in t and a hanger
// at x can be placed with t = (x - x0) / (x2 - x0).
const spans: [Pt, Pt, Pt][] = [
  [[0, 160], [T1 / 2, 150], [T1, TOP + 4]],
  [[T1, TOP + 4], [(T1 + T2) / 2, 262], [T2, TOP + 4]],
  [[T2, TOP + 4], [(T2 + W) / 2, 150], [W, 160]],
];
const cablePath = spans
  .map(([a, b, c], i) => `${i === 0 ? `M${a[0]},${a[1]} ` : ''}Q${b[0]},${b[1]} ${c[0]},${c[1]}`)
  .join(' ');

const hangers: { x: number; y: number }[] = [];
for (const [a, b, c] of spans) {
  for (let x = a[0] + 40; x < c[0] - 10; x += 40) {
    if (Math.abs(x - T1) < 12 || Math.abs(x - T2) < 12) continue;
    const [, y] = quad(a, b, c, (x - a[0]) / (c[0] - a[0]));
    if (DECK - y > 6) hangers.push({ x, y: Math.round(y * 10) / 10 });
  }
}
---

<div class="bridge" aria-hidden="true">
  <svg viewBox={`0 0 ${W} 200`} preserveAspectRatio="xMidYMax slice" focusable="false">
    <g class="bridge__hangers">
      {hangers.map((h) => <line class="bridge__hanger" x1={h.x} y1={h.y} x2={h.x} y2={DECK} />)}
    </g>
    <path class="bridge__cable" d={cablePath} />
    <g class="bridge__towers">
      <path class="bridge__tower" d={`M${T1},${DECK} V${TOP} M${T1 - 9},${TOP} H${T1 + 9}`} />
      <path class="bridge__tower" d={`M${T2},${DECK} V${TOP} M${T2 - 9},${TOP} H${T2 + 9}`} />
    </g>
    <line class="bridge__deck" x1="0" y1={DECK} x2={W} y2={DECK} />
    <line class="bridge__pulse" x1="0" y1={DECK} x2={W} y2={DECK} />
  </svg>
</div>

<style>
  .bridge {
    position: relative;
    width: 100%;
    aspect-ratio: 6 / 1;
    /* On a phone the 6:1 box would shrink the line art to a scribble, so the box
       keeps a taller floor and the drawing is cropped to the main span: both
       towers sit just inside the screen edges and the side spans run off it. */
    min-height: min(30vw, 118px);
    overflow: hidden;
    pointer-events: none;
  }
  .bridge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .bridge line,
  .bridge path {
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Stroke widths are in drawing units, so they are set heavier on phones, where
     the drawing is scaled to about half, and finer on a wide screen. */
  .bridge .bridge__deck { stroke-width: 6; stroke-linecap: butt; }
  .bridge .bridge__tower { stroke-width: 7; }
  .bridge .bridge__cable { stroke-width: 3.4; }
  .bridge .bridge__hanger { stroke-width: 2.2; }
  /* The one light that crosses the finished bridge: blue, and narrower than the
     ink deck it travels along, so the blue only ever sits on ink. Hidden until
     the build sequence runs it, so a static render never shows a stray dash. */
  .bridge .bridge__pulse {
    stroke: var(--blue);
    stroke-width: 3;
    stroke-linecap: butt;
    opacity: 0;
  }
  @media (min-width: 48rem) {
    .bridge .bridge__deck { stroke-width: 4.5; }
    .bridge .bridge__tower { stroke-width: 5.5; }
    .bridge .bridge__cable { stroke-width: 2.4; }
    .bridge .bridge__hanger { stroke-width: 1.5; }
    .bridge .bridge__pulse { stroke-width: 2.25; }
  }
</style>
